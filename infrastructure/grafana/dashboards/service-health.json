{
  "uid": "sentinel-service-health",
  "title": "Service Health",
  "description": "The four signals an on-call engineer opens first: request rate, error rate, latency and logs. The agent reads the same series through metrics-mcp and logs-mcp, so this dashboard is also the human-readable form of its evidence.",
  "tags": ["sentinel-ai"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_request_duration_seconds_count, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second per service. Scenario 10 shows up here as downstream rate rising while upstream rate does not.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$service\"}[2m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of requests answered 5xx. Flat-but-nonzero is a code defect (5, 6); a step at one timestamp is a deployment (14); a sawtooth is a deadlock (3).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$service\", http_response_status_code=~\"5..\"}[2m])) / clamp_min(sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$service\"}[2m])), 0.0001)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95 / p99",
      "description": "High latency with errors is pool exhaustion (1); high latency without errors is a slow query or CPU saturation (2, 4, 15); low latency with errors is a stuck circuit breaker (13).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "{{job}} p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "{{job}} p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Process memory",
      "description": "Scenario 7 is the only one where this climbs monotonically instead of stepping, which is what separates a leak from a load change.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (process_runtime_dotnet_gc_heap_size_bytes{job=~\"$service\"})",
          "legendFormat": "{{job}} heap"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Six of the fifteen scenarios produce no error log from the failing component at all, so an empty panel here is evidence rather than the absence of it.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\"} | severity_text =~ `Warning|Error|Critical`"
        }
      ]
    }
  ]
}
