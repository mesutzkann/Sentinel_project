{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "sentinel-ai",
    "Audience": "sentinel-ai",
    "LifetimeMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "AllowedHosts": "*"
}
