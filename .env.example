# Copy to .env and adjust. .env is gitignored.

# ---- PostgreSQL ----
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_pw
# Host-side port. If a PostgreSQL is already installed on this machine it owns 5432, and
# everything that runs natively - backend, ai-service, alembic - will reach that one
# instead. Pick a free port here in that case.
POSTGRES_PORT=5432

# ---- Sample service ports (host side) ----
GATEWAY_PORT=8080
USERS_PORT=8081
ORDERS_PORT=8082
PAYMENTS_PORT=8083
NOTIFICATIONS_PORT=8084

# ---- Backend ----
BACKEND_PORT=5080
JWT_SIGNING_KEY=dev-only-signing-key-change-me-at-least-32-chars
JWT_ISSUER=sentinel-ai
JWT_AUDIENCE=sentinel-ai
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:5080

# ---- AI service ----
AI_SERVICE_PORT=8000
OLLAMA_BASE_URL=http://localhost:11434
# The 3B to develop against, the 7B to demo with. Measured over the five reasoning fixtures on
# an RTX 3060 Laptop (6 GB): the 3B gets 3 of 5 root causes and finishes 2 of 5 investigations
# in 74 s; the 7B gets 4 of 5 and finishes 4 of 5 in 90 s, or 140 s when it is sharing the card
# with the embedding model. See datasets/evaluation/_README.md.
LLM_MODEL=qwen2.5:3b-instruct
# Per model call, not per investigation. 120 s is comfortable for the 3B, whose slowest call
# measured 35 s. Raise it to 300 when LLM_MODEL is the 7B: 5.12 GB does not fit 6 GB of VRAM, so
# 18% of it runs on the CPU and its calls averaged 43 s under contention — a timeout that fires
# mid-investigation ends the run in FAILED, which is the one way to make a good model look broken.
LLM_TIMEOUT_SECONDS=120
# Attempts, not retries. Constrained decoding usually makes the first one enough.
LLM_MAX_ATTEMPTS=3

# The Phase 8 router: a QLoRA-tuned 1.5B that routes 0.871 of the test split to the right intent
# against the keyword table's 0.354. Import it with `ollama create sentinel-router -f
# models/sentinel-router/Modelfile`; a machine without it keeps working, because the router falls
# back to the keyword table whenever the model is unparseable or absent.
ROUTER_MODEL=sentinel-router
# The one-line prompt the model was trained on. v1 carries the whole intent table, which an
# untuned model needs and a tuned one pays prefill for.
ROUTER_PROMPT_VERSION=v2
# Its own cap, an order of magnitude under the reasoning model's: p95 is 2.3 s on a 6 GB card, and
# anything near this means the model is not on the GPU. Waiting two minutes for a route is worse
# than the keyword table answering now.
ROUTER_TIMEOUT_SECONDS=20
# Set to false to route by keyword table alone, which is what the agent did before Phase 8.
ROUTER_USE_MODEL=true

# What approval tokens are signed with, shared with the backend that issues them. A token is not
# this value: it is an HMAC over the recommendation, the tool and a hash of the arguments, with an
# expiry, so an approval of "restart the orders container" authorises that call and no other.
# Leave it empty and no destructive tool can be called at all, which is the right default.
APPROVAL_SECRET=
# Minutes, not hours: a derived token cannot be revoked before it expires, and an approval
# describes the system the person was looking at when they gave it.
APPROVAL_TTL_SECONDS=600

# Where the AI service reports model_predictions. The backend owns that table, so the AI
# service posts to it rather than writing to a schema it does not own.
BACKEND_BASE_URL=http://localhost:5080

# Shared secret for the backend's /internal surface. Both processes read this one variable.
# It is also the key the per-investigation callback tokens are derived from, unless
# INTERNAL_CALLBACK_SECRET is set (see docs/adr/0002-callback-over-queue.md).
INTERNAL_API_KEY=dev-only-internal-token-change-me

# Where the backend starts investigations. The other direction of BACKEND_BASE_URL above: that
# one is how the AI service reaches the backend, this one is how the backend reaches the agent.
AI_SERVICE_URL=http://localhost:8000

# ---- Hybrid RAG (Phase 5) ----
# Served by the same Ollama as the reasoning model - see docs/adr/0004-embeddings-through-ollama.md.
# `ollama pull bge-m3` before the first ingest.
EMBEDDING_MODEL=bge-m3
# Must match the width rag.document_chunks.embedding was migrated with. Changing it means a
# migration and a re-ingest, not a restart.
EMBEDDING_DIMENSIONS=1024
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
# Candidates each half of a hybrid search contributes before fusion, and how many fused
# candidates the reranker chooses the final five from.
RETRIEVAL_CANDIDATES=30
KNOWLEDGE_BASE_PATH=datasets/knowledge

# ---- Reranking (Phase 6) ----
# A cross-encoder, which Ollama cannot serve, so it runs in the AI service process and is an
# optional install: `pip install -e .[rerank]` in ai-service/. See
# docs/adr/0005-reranker-runs-in-process.md. Without it a hybrid_rerank search returns the fused
# order and says so.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Empty lets sentence-transformers choose; set cuda or cpu to force it. On a 6 GB card already
# holding the reasoning model, cpu is often the faster answer.
RERANK_DEVICE=
# Tokens per (query, chunk) pair. Chunks are ~400 tokens, so 512 covers the pair with room left.
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=16
# Tokens the retrieved context may occupy in a prompt.
CONTEXT_TOKEN_BUDGET=3000

# ---- Observability (Phase 2) ----
# Host-side ports. The stack itself always talks over the compose network, so these only matter
# for reaching a UI from the browser.
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
LOKI_PORT=3100
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Where a natively run process (`dotnet run`) sends OTLP. gRPC, because that is the OTel .NET
# SDK's default protocol. Containers do not use this: compose points them at
# http://otel-collector:4317 directly.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Set to an empty value to start the samples without the observability profile, which disables
# their exporter instead of leaving it retrying against a collector that is not running.
# SAMPLES_OTLP_ENDPOINT=
